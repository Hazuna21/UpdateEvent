                    <Border Width="4" Height="16" CornerRadius="2" Background="{StaticResource RoseBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Saring komentar" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <WrapPanel Margin="0,8,0,4">
                    <StackPanel Margin="0,0,16,8">
