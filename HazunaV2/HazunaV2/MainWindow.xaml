            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,8">
                <DockPanel>
                    <Button x:Name="ConnectBtn" DockPanel.Dock="Right" Content="Hubungkan"
                            Click="ToggleConnect_Click" Style="{StaticResource GoButton}" Padding="18,7"/>
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#FBBF24"
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource TextBrush}" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="TikTok: belum terhubung"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>