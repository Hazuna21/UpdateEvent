<Window x:Class="HazunaV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HazunaV2"
        Title="Hazuna LIVE Control" Height="680" Width="1120"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Cahaya warna di latar -->
        <Rectangle Grid.ColumnSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <DynamicResource ResourceKey="GlowBrush"/>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ================= SIDEBAR ================= -->
                <Border x:Name="Sidebar" Grid.Column="0" Width="230" ClipToBounds="True"
                BorderBrush="{DynamicResource SideLineBrush}" BorderThickness="0,0,1,0">
            <Border.Background>
                <DynamicResource ResourceKey="SidebarBrush"/>
            </Border.Background>
            <DockPanel>
                <!-- Logo + judul -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="19,26,0,26">
                    <Border Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8B5CF6" Offset="0"/>
                                <GradientStop Color="#22D3EE" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="{StaticResource IconBolt}" Fill="White" Width="18" Height="18" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel x:Name="TitleText" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HAZUNA" FontSize="20" FontWeight="Bold">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#C4B5FD" Offset="0"/>
                                    <GradientStop Color="#22D3EE" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="LIVE Control" Foreground="{DynamicResource Muted2Brush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tombol lipat / buka sidebar -->
                <Button DockPanel.Dock="Bottom" Click="ToggleSidebar_Click" Height="38" Margin="14,10,14,16"
                        ToolTip="Lipat / buka menu">
                    <Path Data="{StaticResource IconChevron}" Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="14" Height="14" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="ChevronRotate" Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Button>

                <StackPanel x:Name="NavPanel">
                    <RadioButton Content="Dashboard" Tag="Dashboard" GroupName="Nav" Background="{DynamicResource CyanBrush}"
                                 local:NavIcon.Data="{StaticResource IconDashboard}"
                                 Style="{StaticResource NavItem}" Click="Nav_Click"/>
                    <RadioButton Content="Gift Rules" Tag="Gift Rules" GroupName="Nav" Background="#A78BFA"
                                 local:NavIcon.Data="{StaticResource IconGift}"
                                 Style="{StaticResource NavItem}" Click="Nav_Click"/>
                    <RadioButton Content="Media &amp; Sounds" Tag="Media &amp; Sounds" GroupName="Nav" Background="#F472B6"
                                 local:NavIcon.Data="{StaticResource IconMedia}"
                                 Style="{StaticResource NavItem}" Click="Nav_Click"/>
                    <RadioButton Content="Top Gifters" Tag="Top Gifters" GroupName="Nav" Background="#FBBF24"
                                 local:NavIcon.Data="{StaticResource IconCrown}"
                                 Style="{StaticResource NavItem}" Click="Nav_Click"/>
                    <RadioButton Content="Lucky Wheel" Tag="Lucky Wheel" GroupName="Nav" Background="#F472B6"
                                 local:NavIcon.Data="{StaticResource IconWheel}"
                                 Style="{StaticResource NavItem}" Click="Nav_Click"/>
                    <RadioButton Content="Text to Speech" Tag="Text to Speech" GroupName="Nav" Background="#60A5FA"
                                 local:NavIcon.Data="{StaticResource IconSpeaker}"
                                 Style="{StaticResource NavItem}" Click="Nav_Click"/>
                    <RadioButton Content="AI Reply" Tag="AI Reply" GroupName="Nav" Background="#FB923C"
                                 local:NavIcon.Data="{StaticResource IconSparkle}"
                                 Style="{StaticResource NavItem}" Click="Nav_Click"/>
                    <RadioButton Content="Settings" Tag="Settings" GroupName="Nav" Background="#34D399"
                                 local:NavIcon.Data="{StaticResource IconSettings}"
                                 Style="{StaticResource NavItem}" Click="Nav_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= KONTEN ================= -->
        <Grid Grid.Column="1" Margin="24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle" Grid.Row="0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left">
                <TextBlock.Foreground>
                    <DynamicResource ResourceKey="TitleGradient"/>
                </TextBlock.Foreground>
            </TextBlock>
            <TextBlock x:Name="PageDesc" Grid.Row="1" Foreground="{DynamicResource MutedBrush}"
                       FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>

            <!-- ============ DASHBOARD ============ -->
            <Grid x:Name="DashboardPage" Grid.Row="2" Margin="0,14,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                    <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextBrush}"
                               FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <StackPanel Grid.Row="1">
                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="SimToggleBtn" DockPanel.Dock="Right" Content="Simulasi / uji ▾"
                            Click="ToggleSim_Click" Style="{StaticResource GhostButton}" Padding="12,5"/>
                    <CheckBox x:Name="KeyEnableCheck" IsChecked="True"
                              Content="Aktifkan aksi keyboard (tombol dikirim ke jendela aktif)"
                              VerticalAlignment="Center"/>
                </DockPanel>
                <Border x:Name="SimCard" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="4" Height="18" CornerRadius="2" Background="{DynamicResource CyanBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Simulasi Gift" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="Menguji aturan tanpa TikTok. Pilih atau ketik nama gift yang sama dengan di Gift Rules."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="14,0,0,12" TextWrapping="Wrap"/>
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Nama penonton" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="UserBox" Text="Tester" Width="150"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Gift" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox x:Name="GiftCombo" IsEditable="True" Width="190"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Jumlah" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="CountBox" Text="1" Width="70"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Diamond per gift" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="DiamondBox" Text="1" Width="100"/>
                            </StackPanel>
                            <Button Content="Kirim Gift Simulasi" Click="SendTestGift_Click"
                                    Style="{StaticResource PrimaryButton}" Margin="0,20,0,8" Padding="16,6"/>
                        </WrapPanel>
                        <TextBlock Text="Tap-tap, Follow, dan Share memakai nama penonton di atas."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Jumlah tap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="SimTapBox" Text="50" Width="90"/>
                            </StackPanel>
                            <Button Content="Kirim Tap-tap" Click="SendTestTap_Click"
                                    Style="{StaticResource PrimaryButton}" Margin="0,20,8,8" Padding="16,6"/>
                            <Button Content="Kirim Follow" Click="SendTestFollow_Click"
                                    Style="{StaticResource PrimaryButton}" Margin="0,20,8,8" Padding="16,6"/>
                            <Button Content="Kirim Share" Click="SendTestShare_Click"
                                    Style="{StaticResource PrimaryButton}" Margin="0,20,8,8" Padding="16,6"/>
                            <Button Content="Kirim Join" Click="SendTestJoin_Click"
                                    Style="{StaticResource PrimaryButton}" Margin="0,20,0,8" Padding="16,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Bersihkan Log" Click="ClearLog_Click"
                                Style="{StaticResource GhostButton}" Padding="12,5"/>
                        <Button DockPanel.Dock="Right" Content="Hentikan Antrean"
                                Click="StopAll_Click" Style="{StaticResource DangerButton}"
                                Padding="14,5" Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right" Content="Salin Log" Click="CopyLog_Click"
                                Style="{StaticResource GhostButton}" Padding="12,5" Margin="0,0,8,0"/>
                        <Border Width="4" Height="18" CornerRadius="2" Background="{DynamicResource PinkBrush}"
                                Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Log Aktivitas" Foreground="{DynamicResource TextBrush}" FontSize="16"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QueueText" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="16,0,16,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <ListBox x:Name="LogList" Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource SoftTextBrush}" BorderThickness="0"
                             FontFamily="Consolas" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- ============ GIFT RULES ============ -->
            <Grid x:Name="GiftRulesPage" Grid.Row="2" Margin="0,14,0,10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="+ Tambah Aturan" Click="AddRule_Click"
                            Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Content="Hapus Terpilih" Click="DeleteRule_Click"
                            Style="{StaticResource DangerButton}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Content="Duplikat Terpilih" Click="DuplicateRule_Click"
                            Style="{StaticResource GhostButton}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Content="Impor Daftar Gift" Click="LoadCatalog_Click"
                            Style="{StaticResource GhostButton}" Padding="16,8"/>
                    <TextBlock Text="Geser ☰ untuk urutan · klik dua kali baris untuk mengubah"
                               Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                               Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="320"/>
                </StackPanel>

                <DataGrid x:Name="RulesGrid" Grid.Row="1" CanUserSortColumns="False" AllowDrop="True"
                          MouseDoubleClick="RulesGrid_DoubleClick"
                          DragOver="RulesGrid_DragOver" Drop="RulesGrid_Drop" DragLeave="RulesGrid_DragLeave"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                          RowBackground="{DynamicResource SurfaceBrush}"
                          AlternatingRowBackground="{DynamicResource Surface2Brush}"
                          HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="40" IsReadOnly="True"
                                                CanUserSort="False" CanUserReorder="False" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="☰" FontSize="18" Foreground="{DynamicResource Muted2Brush}" Background="Transparent"
                                               Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Cursor="SizeAll" ToolTip="Tahan dan geser untuk mengubah urutan"
                                               PreviewMouseLeftButtonDown="RuleHandle_Down" PreviewMouseMove="RuleHandle_Move"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Aktif" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource GridCheck}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Pemicu / Gift" Width="*" MinWidth="220" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SourceText}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource Muted2Brush}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Nama efek" Width="220" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EffectDisplay}" Foreground="#E9D5FF" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Suara &amp; volume (1–200%)" Width="340" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,3">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="♪" Click="TestSound_Click"
                                                    Padding="10,2" Margin="4,0,0,0" ToolTip="Tes suara saja"/>
                                            <Button DockPanel.Dock="Right" Content="Pilih..." Click="PickSound_Click"
                                                    Padding="10,2"/>
                                            <TextBlock Text="{Binding SoundName}" Foreground="{DynamicResource SoftTextBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,8,0"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,3,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="%" Foreground="{DynamicResource CyanBrush}"
                                                       VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            <TextBox DockPanel.Dock="Right" Width="48" Padding="3,1" TextAlignment="Right"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding SoundVolume, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     LostFocus="VolumeSlider_Done"/>
                                            <Slider Minimum="1" Maximum="200" SmallChange="1" LargeChange="10"
                                                    IsMoveToPointEnabled="True" Margin="0,0,8,0"
                                                    Value="{Binding SoundVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    LostMouseCapture="VolumeSlider_Done" PreviewKeyUp="VolumeSlider_Done"/>
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="210" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,3">
                                        <Button Content="▶ Tes" Click="TestRule_Click" Padding="12,4" Margin="0,0,6,0"
                                                ToolTip="Jalankan aturan ini satu kali (suara, media, tombol, webhook)"/>
                                        <Button Content="Pengaturan..." Click="EditRule_Click" Padding="12,4"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ============ MEDIA & SOUNDS ============ -->
            <Grid x:Name="MediaPage" Grid.Row="2" Margin="0,14,0,10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Top" Margin="12,0,0,0">
                        <TextBlock Text="Tampilkan:" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="LibraryFilterBox" Width="120" SelectedIndex="0"
                                  SelectionChanged="LibraryFilter_Changed">
                            <ComboBoxItem Content="Semua"/>
                            <ComboBoxItem Content="Suara"/>
                            <ComboBoxItem Content="Media"/>
                        </ComboBox>
                    </StackPanel>
                    <WrapPanel>
                        <Button Content="+ Tambah Suara" Click="AddSound_Click"
                                Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,6"/>
                        <Button Content="+ Tambah Media" Click="AddMedia_Click"
                                Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,6"/>
                        <Button Content="▲ Naik" Click="MoveUp_Click"
                                Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,8,6"/>
                        <Button Content="▼ Turun" Click="MoveDown_Click"
                                Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,8,6"/>
                        <Button Content="Ganti File..." Click="ChangeFile_Click"
                                Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,8,6"/>
                        <Button Content="Hapus dari Daftar" Click="DeleteLibrary_Click"
                                Style="{StaticResource DangerButton}" Padding="14,8" Margin="0,0,8,6"/>
                        <Button Content="Stop Suara" Click="StopSound_Click"
                                Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,8,6"/>
                    </WrapPanel>
                </DockPanel>

                <DataGrid x:Name="LibraryGrid" Grid.Row="1"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserSortColumns="False"
                          Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                          RowBackground="{DynamicResource SurfaceBrush}"
                          AlternatingRowBackground="{DynamicResource Surface2Brush}"
                          HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nama (bisa diubah)"
                                            Binding="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                            Width="*" MinWidth="180"/>
                        <DataGridTemplateColumn Header="Jenis" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedValuePath="Content" Margin="4,2"
                                              SelectedValue="{Binding Kind, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem Content="Suara"/>
                                        <ComboBoxItem Content="Media"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Format" Binding="{Binding Format, Mode=OneWay}"
                                            IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}"
                                            IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="Lokasi" Binding="{Binding FilePath, Mode=OneWay}"
                                            IsReadOnly="True" Width="2*"/>
                        <DataGridTemplateColumn Header="" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Tes" Click="TestLibraryItem_Click"
                                            Padding="10,3" Margin="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ============ TOP GIFTERS ============ -->
            <Grid x:Name="TopGiftersPage" Grid.Row="2" Margin="0,14,0,10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="AllOverlayBtn" Content="Buka Semua Overlay" Click="ToggleAllOverlays_Click"
                            Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                    <TextBlock Text="Tema:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                    <ComboBox x:Name="ThemeCombo" Width="140" Margin="0,0,16,0" SelectionChanged="Theme_Changed"/>
                    <Button x:Name="OverlayToggleBtn" Visibility="Collapsed" Content="Buka Overlay" Click="ToggleOverlay_Click"
                            Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button x:Name="MenuOverlayBtn" Visibility="Collapsed" Content="Buka Overlay Menu Gift" Click="ToggleMenuOverlay_Click"
                            Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Content="+ Data Uji" Click="AddTestGift_Click"
                            Style="{StaticResource GhostButton}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Content="Reset Leaderboard" Click="ResetBoard_Click"
                            Style="{StaticResource DangerButton}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button x:Name="BoardOptionsBtn" Content="Opsi ▾" Click="ToggleBoardOptions_Click"
                            Style="{StaticResource GhostButton}" Padding="16,8"/>
                </StackPanel>

                <WrapPanel x:Name="BoardOptions" Grid.Row="1" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock Text="Urutkan berdasarkan:" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="150" SelectedIndex="0" SelectionChanged="SortCombo_Changed">
                        <ComboBoxItem Content="Diamonds"/>
                        <ComboBoxItem Content="Jumlah Gift"/>
                    </ComboBox>
                    <CheckBox x:Name="LoyalEnableCheck" Content="Alert penonton setia" Click="LoyalOption_Changed"
                              VerticalAlignment="Center" Margin="24,0,8,0"
                              ToolTip="Penonton yang hadir di beberapa LIVE atau total gift-nya besar diberi sambutan khusus."/>
                    <TextBlock Text="hadir di" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="LoyalVisitsBox" Width="42" LostFocus="LoyalOption_Changed"/>
                    <TextBlock Text="LIVE atau total" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,6,0"/>
                    <TextBox x:Name="LoyalDiamondsBox" Width="70" LostFocus="LoyalOption_Changed"/>
                    <TextBlock Text="diamond" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,8,0"/>
                    <CheckBox x:Name="LoyalSpeakCheck" Content="Bacakan" Click="LoyalOption_Changed" VerticalAlignment="Center"/>
                    <TextBlock Text="Gift besar mulai (diamond):" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="24,0,8,0"/>
                    <TextBox x:Name="KindnessBigBox" Width="70" LostFocus="KindnessBig_LostFocus"
                             ToolTip="Gift sebesar ini memicu ucapan terima kasih besar di overlay Kebaikan Hati Penonton. 0 = mati."/>
                    <CheckBox x:Name="AutoShowCheck" Content="Tampilkan overlay otomatis saat aplikasi dibuka"
                              VerticalAlignment="Center" Margin="24,0,0,0" Click="AutoShow_Click"/>
                    <CheckBox x:Name="ChromaCheck" Content="Latar hijau (untuk chroma key)"
                              VerticalAlignment="Center" Margin="24,0,0,0" Click="ChromaCheck_Click"/>
                    <TextBlock Text="Ukuran overlay menu gift:" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="24,0,8,0"/>
                    <ComboBox x:Name="MenuScaleCombo" Width="250" SelectionChanged="MenuScale_Changed">
                        <ComboBoxItem Content="Kecil 864×480 (9×5 inci)"/>
                        <ComboBoxItem Content="Sedang 1296×720"/>
                        <ComboBoxItem Content="HD 1920×1067 (untuk TikTok Studio)"/>
                    </ComboBox>
                </WrapPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="ScoreOverlayBtn" Visibility="Collapsed" DockPanel.Dock="Right" Content="Buka Overlay Skor"
                                    Click="ToggleScoreOverlay_Click" Style="{StaticResource PrimaryButton}" Padding="16,8"/>
                            <TextBlock x:Name="ScoreValueText" Text="WIN = 0 / 50" Foreground="{DynamicResource TextBrush}"
                                       FontSize="26" FontWeight="Black" VerticalAlignment="Center"/>
                        </DockPanel>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="−1" Click="ScoreMinus_Click" Padding="14,5" Margin="0,0,6,0"/>
                            <Button Content="+1" Click="ScorePlus_Click" Padding="14,5" Margin="0,0,16,0"/>
                            <TextBlock Text="Atur skor ke:" Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="ScoreSetBox" Width="60" Margin="0,0,6,0"/>
                            <Button Content="Terapkan" Click="ScoreSet_Click" Padding="12,5" Margin="0,0,6,0"/>
                            <Button Content="Reset ke 0" Click="ScoreReset_Click" Style="{StaticResource DangerButton}" Padding="12,5"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Text="Target:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="ScoreTargetBox" Width="55" Margin="0,0,16,0"/>
                            <TextBlock Text="Sampai puncak:  +" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="ScoreWinBox" Width="45" Margin="0,0,16,0"/>
                            <TextBlock Text="Mati:  −" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="ScoreDeathBox" Width="45" Margin="0,0,10,0"/>
                            <Button Content="Simpan aturan" Click="ScoreRules_Click" Style="{StaticResource GhostButton}" Padding="12,5"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="BoardGrid" Grid.Row="3"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                          RowBackground="{DynamicResource SurfaceBrush}"
                          AlternatingRowBackground="{DynamicResource Surface2Brush}"
                          HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Peringkat" Binding="{Binding Rank}" Width="100"/>
                        <DataGridTextColumn Header="Nama" Binding="{Binding UserName}" Width="*"/>
                        <DataGridTextColumn Header="Diamonds" Binding="{Binding Diamonds, StringFormat=N0}" Width="160"/>
                        <DataGridTextColumn Header="Jumlah Gift" Binding="{Binding GiftCount}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ============ LUCKY WHEEL ============ -->
            <Grid x:Name="WheelPage" Grid.Row="2" Margin="0,14,0,10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,16,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Daftar wheel" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                            <ListBox x:Name="WheelList" DisplayMemberPath="Name" Height="110" Margin="0,8,0,8"
                                     Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                     SelectionChanged="WheelList_SelectionChanged"/>
                            <WrapPanel Margin="0,0,0,16">
                                <Button Content="+ Wheel Baru" Click="WheelNew_Click" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,8,0"/>
                                <Button Content="Duplikat" Click="WheelDuplicate_Click" Style="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,8,0"/>
                                <Button Content="Hapus" Click="WheelRemove_Click" Style="{StaticResource DangerButton}" Padding="12,6"/>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource PinkBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Wheel terpilih" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="Nama (tampil di atas roda)" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="14,8,0,4"/>
                            <TextBox x:Name="WheelNameBox" LostFocus="WheelField_LostFocus" Margin="0,0,0,10"/>

                            <TextBlock Text="Gift pemutar" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="14,0,0,4"/>
                            <Button x:Name="WheelGiftBtn" Click="WheelPickGift_Click" Padding="10,7"
                                    HorizontalContentAlignment="Stretch" Background="{DynamicResource Raised2Brush}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="▾" Foreground="{DynamicResource CyanBrush}" Margin="8,0,0,0"/>
                                    <TextBlock x:Name="WheelGiftText" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Button>
                            <CheckBox x:Name="WheelPerGiftCheck" Click="WheelOption_Click" Margin="0,10,0,8"
                                      Content="Putar sekali untuk tiap gift (kirim 3 = 3 putaran, maks 10)"/>
                            <CheckBox x:Name="WheelShuffleCheck" Click="WheelOption_Click" Margin="0,0,0,14"
                                      Content="Acak posisi isi di roda sebelum tiap putaran"/>

                            <TextBlock Text="Lama roda berputar (detik)" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="14,0,0,4"/>
                            <TextBox x:Name="WheelSecondsBox" Width="90" HorizontalAlignment="Left" LostFocus="WheelField_LostFocus"/>
                            <TextBlock Text="Lama tombol hasil dijalankan (detik)" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="14,8,0,4"/>
                            <TextBox x:Name="WheelActionBox" Width="90" HorizontalAlignment="Left" Margin="0,0,0,16" LostFocus="WheelField_LostFocus"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource AmberBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Suara" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="Suara saat roda berputar" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="14,0,0,4"/>
                            <DockPanel Margin="0,0,0,8">
                                <TextBox x:Name="WheelSpinVolBox" DockPanel.Dock="Right" Width="52" Margin="6,0,0,0" ToolTip="Volume 1-200%" LostFocus="WheelField_LostFocus"/>
                                <Button DockPanel.Dock="Right" Content="Hapus" Tag="spin" Click="WheelClearSound_Click" Style="{StaticResource GhostButton}" Padding="10,6" Margin="6,0,0,0"/>
                                <Button DockPanel.Dock="Right" Content="Pilih..." Tag="spin" Click="WheelPickSound_Click" Style="{StaticResource GhostButton}" Padding="10,6" Margin="6,0,0,0"/>
                                <TextBlock x:Name="WheelSpinSoundText" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="Suara saat hasil keluar" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="14,0,0,4"/>
                            <DockPanel Margin="0,0,0,16">
                                <TextBox x:Name="WheelResultVolBox" DockPanel.Dock="Right" Width="52" Margin="6,0,0,0" ToolTip="Volume 1-200%" LostFocus="WheelField_LostFocus"/>
                                <Button DockPanel.Dock="Right" Content="Hapus" Tag="result" Click="WheelClearSound_Click" Style="{StaticResource GhostButton}" Padding="10,6" Margin="6,0,0,0"/>
                                <Button DockPanel.Dock="Right" Content="Pilih..." Tag="result" Click="WheelPickSound_Click" Style="{StaticResource GhostButton}" Padding="10,6" Margin="6,0,0,0"/>
                                <TextBlock x:Name="WheelResultSoundText" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource AmberBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Overlay" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="Semua roda memakai satu jendela &quot;Lucky Wheel Overlay&quot; yang selalu ada (tangkap sekali di TikTok Studio). Roda tak terlihat sampai gift pemutarnya masuk, lalu hilang setelah selesai."
                                       Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="14,2,0,8"/>
                            <CheckBox x:Name="WheelAlwaysCheck" Click="WheelOption_Click" Margin="0,0,0,8"
                                      Content="Selalu tampil (tidak disembunyikan)"/>
                            <Button x:Name="WheelOverlayBtn" Content="Tampilkan / atur posisi" Click="ToggleWheelOverlay_Click"
                                    Style="{StaticResource GhostButton}" Padding="14,7" Margin="0,0,0,12" HorizontalAlignment="Left"/>

                            <Button Content="▶ Tes Putar" Click="WheelTest_Click" Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ Tambah Isi" Click="WheelAdd_Click" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="Hapus Terpilih" Click="WheelDelete_Click" Style="{StaticResource DangerButton}" Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="🔀 Acak Urutan" Click="WheelShuffle_Click" Style="{StaticResource GhostButton}" Padding="16,8" Margin="0,0,8,0"/>
                        <TextBlock Text="Bobot lebih besar = lebih sering terpilih. Skor WIN: angka yang ditambahkan (atau dikurangi dengan minus) ke skor saat isi itu menang."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                                   Margin="6,0,0,0" TextWrapping="Wrap" MaxWidth="360"/>
                    </StackPanel>
                    <DataGrid x:Name="WheelGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              CellEditEnding="WheelGrid_CellEditEnding"
                              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                              RowBackground="{DynamicResource SurfaceBrush}"
                              AlternatingRowBackground="{DynamicResource Surface2Brush}"
                              HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Isi roda (teks)" Binding="{Binding Text, UpdateSourceTrigger=LostFocus}" Width="*"/>
                            <DataGridTextColumn Header="Bobot" Binding="{Binding Weight, UpdateSourceTrigger=LostFocus}" Width="90"/>
                            <DataGridTextColumn Header="Skor WIN (+/−)" Binding="{Binding ScoreDelta, UpdateSourceTrigger=LostFocus}" Width="110"/>
                            <DataGridTemplateColumn Header="Tombol (opsional)" Width="200" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="4,2">
                                            <Button DockPanel.Dock="Right" Content="Atur..." Click="WheelPickKey_Click" Padding="10,3" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding KeyDisplay}" Foreground="{DynamicResource SoftTextBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <!-- ============ TEXT TO SPEECH ============ -->
<Grid x:Name="TtsPage" Grid.Row="2" Margin="0,14,0,10" Visibility="Collapsed">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Pengaturan -->
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,16,0">
            <StackPanel>
                <CheckBox x:Name="TtsEnableCheck" Content="Baca komentar TikTok dengan suara"
                          Click="TtsEnable_Click" FontSize="14" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource CyanBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Suara" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <ComboBox x:Name="TtsVoiceBox" DisplayMemberPath="Label" SelectedValuePath="Name"
                          SelectionChanged="TtsVoice_Changed" Margin="0,8,0,10"/>
                <StackPanel x:Name="TtsPitchPanel" Margin="0,0,0,18">
                    <TextBlock Text="Tinggi nada suara Anime (makin tinggi makin imut)" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <DockPanel>
                        <TextBlock x:Name="TtsPitchLabel" DockPanel.Dock="Right" Width="52" TextAlignment="Right"
                                   Foreground="{DynamicResource CyanBrush}" FontWeight="SemiBold" Text="1.4x"/>
                        <Slider x:Name="TtsPitchSlider" Minimum="1" Maximum="2" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" Value="1.4" ValueChanged="TtsPitch_Changed"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource PinkBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Kecepatan" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <DockPanel Margin="0,8,0,18">
                    <TextBlock x:Name="TtsRateLabel" DockPanel.Dock="Right" Width="52" TextAlignment="Right"
                               Foreground="{DynamicResource CyanBrush}" FontWeight="SemiBold" Text="0"/>
                    <Slider x:Name="TtsRateSlider" Minimum="-10" Maximum="10" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="TtsRate_Changed"/>
                </DockPanel>

                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource AmberBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Volume" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <DockPanel Margin="0,8,0,18">
                    <TextBlock x:Name="TtsVolumeLabel" DockPanel.Dock="Right" Width="52" TextAlignment="Right"
                               Foreground="{DynamicResource CyanBrush}" FontWeight="SemiBold" Text="100%"/>
                    <Slider x:Name="TtsVolumeSlider" Minimum="0" Maximum="100" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="TtsVolume_Changed"/>
                </DockPanel>

                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource GreenBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Format bacaan" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="Pakai {user} untuk nama penonton dan {text} untuk isi komentar. Isi {text} saja kalau nama tidak perlu dibaca."
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="14,2,0,0"/>
                <TextBox x:Name="TtsTemplateBox" LostFocus="TtsField_LostFocus" Margin="0,8,0,18"/>

                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource RoseBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Saring komentar" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <WrapPanel Margin="0,8,0,4">
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="Panjang maks (karakter)" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TtsMaxCharsBox" Width="90" LostFocus="TtsField_LostFocus"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Antrean maks (komentar)" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TtsMaxQueueBox" Width="90" LostFocus="TtsField_LostFocus"/>
                    </StackPanel>
                </WrapPanel>
                <CheckBox x:Name="TtsSkipCmdCheck" Content="Lewati perintah (diawali ! atau /)"
                          Click="TtsOption_Click" Margin="0,4,0,6"/>
                <CheckBox x:Name="TtsSkipLinkCheck" Content="Buang tautan dari komentar"
                          Click="TtsOption_Click" Margin="0,0,0,18"/>

                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource BlueBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Uji suara" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBox x:Name="TtsTestBox" Text="Halo, ini tes suara." Margin="0,8,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Tes Suara" Click="TtsTest_Click"
                            Style="{StaticResource PrimaryButton}" Padding="16,7" Margin="0,0,8,0"/>
                    <Button Content="Hentikan &amp; Kosongkan" Click="TtsStop_Click"
                            Style="{StaticResource DangerButton}" Padding="14,7"/>
                </StackPanel>

                <TextBlock x:Name="TtsNote" Foreground="Orange" FontSize="12"
                           TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </ScrollViewer>

    <!-- Komentar terakhir -->
    <Grid Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Bersihkan" Click="ClearChatLog_Click"
                    Style="{StaticResource GhostButton}" Padding="12,5"/>
            <Border Width="4" Height="18" CornerRadius="2" Background="{DynamicResource CyanBrush}"
                    Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="Komentar Terakhir" Foreground="{DynamicResource TextBrush}" FontSize="16"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock x:Name="TtsStatus" Grid.Row="1" Foreground="{DynamicResource MutedBrush}"
                   FontSize="12" Margin="14,0,0,10" TextTrimming="CharacterEllipsis"/>

        <ListBox x:Name="ChatList" Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                 Foreground="{DynamicResource SoftTextBrush}" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Grid>

<!-- ============ AI REPLY ============ -->
<Grid x:Name="AiPage" Grid.Row="2" Margin="0,14,0,10" Visibility="Collapsed">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Pengaturan -->
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,16,0">
            <StackPanel>
                <CheckBox x:Name="AiEnableCheck" Content="Jawab komentar otomatis dengan AI"
                          Click="AiEnable_Click" FontSize="14" Margin="0,0,0,4"/>
                <TextBlock Text="Saklar ini selalu mati saat aplikasi dibuka, karena setiap komentar memakai API berbayar."
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource AmberBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="API key (Claude atau Gemini)" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="Claude: buat di console.anthropic.com, model contoh claude-haiku-5-5. Gemini: buat di aistudio.google.com, lalu isi Model dengan nama berawalan gemini (contoh gemini-2.5-flash). Satu kunci saja, sesuai model yang dipilih. Kunci disimpan di komputer ini sebagai teks biasa; jangan tampilkan layar ini saat siaran."
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="14,2,0,0"/>
                <PasswordBox x:Name="AiKeyBox" LostFocus="AiField_LostFocus" Margin="0,8,0,18" Padding="8,6"
                             Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}"/>

                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource CyanBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Model" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBox x:Name="AiModelBox" LostFocus="AiField_LostFocus" Margin="0,8,0,18"/>

                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource PinkBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Kepribadian AI" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="Ceritakan siapa kamu dan tentang apa siaranmu, supaya jawaban AI nyambung."
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="14,2,0,0"/>
                <TextBox x:Name="AiPersonaBox" LostFocus="AiField_LostFocus" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="120" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" Margin="0,8,0,18"/>

                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource GreenBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Batas dan biaya" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <WrapPanel Margin="0,8,0,4">
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="Jeda antar jawaban (detik)" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="AiCooldownBox" Width="90" LostFocus="AiField_LostFocus"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="Antrean maks (komentar)" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="AiMaxPendingBox" Width="90" LostFocus="AiField_LostFocus"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Panjang jawaban (karakter)" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="AiMaxCharsBox" Width="90" LostFocus="AiField_LostFocus"/>
                    </StackPanel>
                </WrapPanel>
                <CheckBox x:Name="AiOnlyQuestionsCheck" Content="Hanya jawab komentar yang berupa pertanyaan"
                          Click="AiOption_Click" Margin="0,4,0,8"/>
                <CheckBox x:Name="AiWelcomeCheck" Content="Sambut penonton yang baru bergabung (tiap penonton satu kali)"
                          Click="AiOption_Click" Margin="0,0,0,8"/>
                <CheckBox x:Name="AiReactCheck" Content="Beri reaksi otomatis pada kejadian di game (mati, sampai puncak, hasil roda, gift, zombie)"
                          Click="AiOption_Click" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <TextBlock Text="Jeda minimal antar reaksi (detik):" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="AiReactCooldownBox" Width="70" LostFocus="AiField_LostFocus"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource BlueBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Suara" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <CheckBox x:Name="AiSpeakCheck" Content="Bacakan jawaban AI dengan suara"
                          Click="AiOption_Click" Margin="0,8,0,8"/>
                <TextBlock Text="Format ucapan: {user} = nama penonton, {text} = jawaban AI."
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="AiTemplateBox" LostFocus="AiField_LostFocus" Margin="0,0,0,18"/>

                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource RoseBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Uji AI" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBox x:Name="AiTestBox" Text="Halo, kamu siapa?" Margin="0,8,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AiTestBtn" Content="Tes Tanya AI" Click="AiTest_Click"
                            Style="{StaticResource PrimaryButton}" Padding="16,7" Margin="0,0,8,0"/>
                    <Button Content="Hentikan &amp; Kosongkan" Click="AiStop_Click"
                            Style="{StaticResource DangerButton}" Padding="14,7"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>

    <!-- Tanya jawab -->
    <Grid Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Bersihkan" Click="ClearAiLog_Click"
                    Style="{StaticResource GhostButton}" Padding="12,5"/>
            <Border Width="4" Height="18" CornerRadius="2" Background="{DynamicResource AmberBrush}"
                    Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="Tanya Jawab" Foreground="{DynamicResource TextBrush}" FontSize="16"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock x:Name="AiStatus" Grid.Row="1" Foreground="{DynamicResource MutedBrush}"
                   FontSize="12" Margin="14,0,0,10" TextTrimming="CharacterEllipsis"/>

        <ListBox x:Name="AiList" Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                 Foreground="{DynamicResource SoftTextBrush}" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Grid>

            <!-- ============ SETTINGS ============ -->
            <ScrollViewer x:Name="SettingsPage" Grid.Row="2" Margin="0,14,0,10"
                          Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}" MaxWidth="620" HorizontalAlignment="Left" Padding="24,20">
                    <StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource PinkBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Tema aplikasi" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="Warna tampilan jendela ini. Tidak mengubah tema overlay."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="14,2,0,0"/>
                        <ComboBox x:Name="AppThemeCombo" Width="220" HorizontalAlignment="Left" Margin="0,8,0,22"
                                  SelectionChanged="AppTheme_Changed"/>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource GreenBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Permintaan lagu dari chat" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="Penonton mengetik perintah lalu judul, misalnya &quot;!lagu nama suara&quot;. Yang bisa diminta: semua item jenis Suara di Media &amp; Sounds."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="14,2,0,6"/>
                        <CheckBox x:Name="SongReqCheck" Content="Aktifkan permintaan lagu" Click="SongReq_Changed" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="Perintah" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="SongReqCmdBox" Width="90" LostFocus="SongReq_Changed" Margin="0,0,18,6"/>
                            <TextBlock Text="Jeda per orang (detik)" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="SongReqUserBox" Width="50" LostFocus="SongReq_Changed" Margin="0,0,18,6"/>
                            <TextBlock Text="Jeda umum (detik)" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="SongReqGlobalBox" Width="50" LostFocus="SongReq_Changed" Margin="0,0,18,6"/>
                            <TextBlock Text="Volume (%)" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="SongReqVolumeBox" Width="50" LostFocus="SongReq_Changed" Margin="0,0,18,6"/>
                            <TextBlock Text="Maks. putar (detik, 0 = penuh)" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="SongReqMaxBox" Width="50" LostFocus="SongReq_Changed" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <Button Content="Salin daftar perintah" Click="SongReqCopyList_Click"
                                Style="{StaticResource GhostButton}" Padding="14,7" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="SongReqStatus" Foreground="{DynamicResource GreenBrush}" FontSize="12" Margin="0,6,0,14"/>

                        <TextBlock Text="Permintaan dari YouTube" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="14,0,0,2"/>
                        <TextBlock Text="Penonton mengetik misalnya &quot;!play judul artis&quot;. Audio dicari dan diunduh dengan yt-dlp (diunduh otomatis, perlu internet). Jeda, volume, dan batas putar memakai pengaturan di atas. Awas: memutar lagu berhak cipta di LIVE bisa membuat suara dibisukan atau akun diperingatkan TikTok, dan mengunduh dari YouTube melanggar ketentuan layanannya."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="14,0,0,6"/>
                        <CheckBox x:Name="YtCheck" Content="Aktifkan permintaan dari YouTube" Click="YtOption_Changed" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="Perintah" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="YtCmdBox" Width="90" LostFocus="YtOption_Changed" Margin="0,0,18,6"/>
                            <TextBlock Text="Maks. durasi video (menit)" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="YtMaxBox" Width="50" LostFocus="YtOption_Changed" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <Button x:Name="YtInstallBtn" Content="Pasang / perbarui yt-dlp" Click="YtInstall_Click"
                                Style="{StaticResource GhostButton}" Padding="14,7" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="YtStatus" Foreground="{DynamicResource GreenBrush}" FontSize="12" Margin="0,6,0,22" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource CyanBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Akun TikTok" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="Nama pengguna tanpa @. Dipakai saat menghubungkan ke LIVE."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="14,2,0,0"/>
                        <TextBox x:Name="UsernameBox" Margin="0,8,0,8"/>
                        <CheckBox x:Name="AutoConnectCheck" Click="AutoConnect_Click" Margin="0,0,0,22"
                                  Content="Hubungkan otomatis saat LIVE dimulai (dicoba tiap 20 detik)"/>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource AmberBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="API key TikTools (opsional)" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="Tidak wajib. Kunci disimpan di komputer ini dalam bentuk teks biasa; jangan tampilkan layar ini saat siaran."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="14,2,0,0"/>
                        <PasswordBox x:Name="ApiKeyBox" Margin="0,8,0,22" Padding="8,6"
                                     Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}"/>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource GreenBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Tunda uji tombol (detik)" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="Hanya untuk gift simulasi, memberi waktu berpindah ke jendela lain. Gift asli dari TikTok tidak ditunda."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="14,2,0,0"/>
                        <TextBox x:Name="SimDelayBox" Width="80" HorizontalAlignment="Left" Margin="0,8,0,22"/>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource GreenBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Update aplikasi" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="UpdateVersionText" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="14,2,0,6"/>
                        <TextBlock Text="Repo GitHub (pemilik/nama-repo)" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="14,0,0,2"/>
                        <TextBox x:Name="UpdateRepoBox" Width="300" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <TextBlock Text="Token GitHub (hanya kalau repo private, boleh kosong)" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="14,0,0,2"/>
                        <PasswordBox x:Name="UpdateTokenBox" Width="300" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="UpdateButton" Content="Cek &amp; Update" Click="CheckUpdate_Click"
                                    Style="{StaticResource PrimaryButton}" Padding="18,8" Margin="0,0,8,0"/>
                            <Button x:Name="WhatsNewButton" Content="Apa yang baru" Click="WhatsNew_Click"
                                    Style="{StaticResource GhostButton}" Padding="16,8"/>
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatus" Foreground="{DynamicResource GreenBrush}" FontSize="12" Margin="0,8,0,22" TextWrapping="Wrap"/>

                        <TextBlock Text="Catatan: saklar &quot;Aktifkan aksi keyboard&quot; di Dashboard tidak disimpan dan selalu mati saat aplikasi dibuka, demi keamanan."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Simpan Pengaturan" Click="SaveSettings_Click"
                                    Style="{StaticResource PrimaryButton}" Padding="18,8" Margin="0,0,8,0"/>
                            <Button Content="Buka Folder Data" Click="OpenDataFolder_Click"
                                    Style="{StaticResource GhostButton}" Padding="16,8"/>
                        </StackPanel>
                        <TextBlock x:Name="SettingsStatus" Foreground="{DynamicResource GreenBrush}"
                                   FontSize="12" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- ============ BILAH STATUS ============ -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,8">
                <DockPanel>
                    <Button x:Name="ConnectBtn" DockPanel.Dock="Right" Content="Hubungkan"
                            Click="ToggleConnect_Click" Style="{StaticResource GoButton}" Padding="18,7"/>
                    <Button DockPanel.Dock="Right" Content="Ringkasan" Click="ShowSummary_Click"
                            Style="{StaticResource GhostButton}" Padding="14,7" Margin="0,0,8,0"/>
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{DynamicResource AmberBrush}"
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextBrush}" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="TikTok: belum terhubung"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>