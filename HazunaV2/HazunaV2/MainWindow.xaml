                        <TextBox x:Name="TtsMaxCharsBox" Width="90" LostFocus="TtsField_LostFocus"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Antrean maks (komentar)" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TtsMaxQueueBox" Width="90" LostFocus="TtsField_LostFocus"/>
                    </StackPanel>
                </WrapPanel>
